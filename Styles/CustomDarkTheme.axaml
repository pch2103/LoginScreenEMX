        <!--  Рзмеры -->
        <x:Double x:Key="ThemeSize-Min">4</x:Double>
        <x:Double x:Key="ThemeSize-Half">6</x:Double>
        <x:Double x:Key="ThemeSize-Regular">12</x:Double>
        <x:Double x:Key="ThemeSize-Medium">16</x:Double>
        <x:Double x:Key="ThemeSize-Double">24</x:Double>
        <x:Double x:Key="ThemeSize-Large">32</x:Double>
        <Thickness x:Key="ThemePadding-Regular">12,12,12,12</Thickness>
        <Thickness x:Key="ThemePadding-Medium">16,16,16,16</Thickness>
        <Thickness x:Key="ThemePadding-Double">32,32,32,32</Thickness>
        <Thickness x:Key="ThemePaddingDown-Half">0,0,0,6</Thickness>
        <Thickness x:Key="ThemePaddingDown-Regular">0,0,0,12</Thickness>
        <Thickness x:Key="ThemePaddingDown-Medium">0,0,0,16</Thickness>
        <!-- Основные цвета -->
        <Color x:Key="ThemeBackgroundColor">#0A0A0A</Color>
        <Color x:Key="ThemeBackgroundColor-900">#191919</Color>
        <Color x:Key="ThemeBackgroundColor-800">#2A2A2A</Color>
        <Color x:Key="ThemeBackgroundColor-700">#3D3D3D</Color>
        <Color x:Key="ThemeBackgroundColor-600">#484848</Color>
        <Color x:Key="ThemeBackgroundColor-500">#656565</Color>
        <Color x:Key="ThemeBackgroundColor-400">#858585</Color>
        <Color x:Key="ThemeBackgroundColor-100">#D6D6D6</Color>
        <Color x:Key="ThemeBackgroundColorLight">#D6D6D6</Color>
        <Color x:Key="ThemeForegroundColor">#F6F6F6</Color>
        <Color x:Key="ThemeWhite">#FFFFFF</Color>

        <!-- PrimaryColor -->
        <Color x:Key="ThemePrimaryColorTint20">#0082F7</Color>
        <Color x:Key="ThemePrimaryColorTint10">#0082F7</Color>
        <Color x:Key="ThemePrimaryColor">#0070E4</Color>
        <Color x:Key="ThemePrimaryColorShade10">#0053A8</Color>
        <Color x:Key="ThemePrimaryColorShade20">#004184</Color>
        
        <!-- OtherColor -->
        <Color x:Key="ThemeRed">#FF0000</Color>
        <Color x:Key="ThemeGreen">#20D300</Color>
        <Color x:Key="ThemeOrange">#FF8A00</Color>
        <CornerRadius x:Key="PopupCornerRadius">24</CornerRadius>

        <FontFamily x:Key="DefaultFont">Segoe UI, Roboto, San Francisco, sans-serif</FontFamily>

        <!-- Кисти на основе цветов Background и Foreground-->
        <SolidColorBrush x:Key="BackgroundColor" Color="{DynamicResource ThemeTransparent}" />
        <SolidColorBrush x:Key="BackgroundColor-900" Color="{DynamicResource ThemeBackgroundColor-900}" />
        <SolidColorBrush x:Key="BackgroundColor-800" Color="{DynamicResource ThemeBackgroundColor-800}" />
        <SolidColorBrush x:Key="BackgroundColor-700" Color="{DynamicResource ThemeBackgroundColor-700}" />
        <SolidColorBrush x:Key="BackgroundColor-600" Color="{DynamicResource ThemeBackgroundColor-600}" />
        <SolidColorBrush x:Key="BackgroundColor-500" Color="{DynamicResource ThemeBackgroundColor-500}" />
        <SolidColorBrush x:Key="BackgroundColor-400" Color="{DynamicResource ThemeBackgroundColor-400}" />

        <SolidColorBrush x:Key="BackgroundColor-80" Color="{DynamicResource ThemeBackgroundColor}" Opacity="0.8" />
        <SolidColorBrush x:Key="BackgroundColor-60" Color="{DynamicResource ThemeBackgroundColor}" Opacity="0.6" />
        <SolidColorBrush x:Key="BackgroundColor-40" Color="{DynamicResource ThemeBackgroundColor}" Opacity="0.4" />
        <SolidColorBrush x:Key="BackgroundColor-20" Color="{DynamicResource ThemeBackgroundColor}" Opacity="0.2" />
        <SolidColorBrush x:Key="BackgroundColor-10" Color="{DynamicResource ThemeBackgroundColor}" Opacity="0.1" />

        <SolidColorBrush x:Key="ForegroundColor" Color="{DynamicResource ThemeForegroundColor}" />
        <SolidColorBrush x:Key="ForegroundColor-80" Color="{DynamicResource ThemeForegroundColor}" Opacity="0.8" />
        <SolidColorBrush x:Key="ForegroundColor-60" Color="{DynamicResource ThemeForegroundColor}" Opacity="0.6" />
        <SolidColorBrush x:Key="ForegroundColor-40" Color="{DynamicResource ThemeForegroundColor}" Opacity="0.4" />
        <SolidColorBrush x:Key="ForegroundColor-20" Color="{DynamicResource ThemeForegroundColor}" Opacity="0.2" />
        <SolidColorBrush x:Key="ForegroundColor-10" Color="{DynamicResource ThemeForegroundColor}" Opacity="0.1" />

        <SolidColorBrush x:Key="PrimaryColorTint20" Color="{DynamicResource ThemePrimaryColorTint20}" />
        <SolidColorBrush x:Key="PrimaryColorTint10" Color="{DynamicResource ThemePrimaryColorTint10}" />
        <SolidColorBrush x:Key="PrimaryColor" Color="{DynamicResource ThemePrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryColorShade10" Color="{DynamicResource ThemePrimaryColorShade10}" />
        <SolidColorBrush x:Key="PrimaryColorShade20" Color="{DynamicResource ThemePrimaryColorShade20}" />
        <SolidColorBrush x:Key="PrimaryColor-40" Color="{DynamicResource ThemePrimaryColor}"   Opacity="0.4"/>
        <SolidColorBrush x:Key="GreenColor" Color="{DynamicResource ThemeGreen}"/>
        <SolidColorBrush x:Key="GreenColor-40" Color="{DynamicResource ThemeGreen}"   Opacity="0.4"/>
        <SolidColorBrush x:Key="RedColor" Color="{DynamicResource ThemeRed}"/>
        <SolidColorBrush x:Key="RedColor-40" Color="{DynamicResource ThemeRed}"   Opacity="0.4"/>
        <SolidColorBrush x:Key="OrangeColor" Color="{DynamicResource ThemeOrange}"/>
        <SolidColorBrush x:Key="OrangeColor-40" Color="{DynamicResource ThemeOrange}"   Opacity="0.4"/>
        
        <SolidColorBrush x:Key="TransparentColor" Color="{DynamicResource ThemeTransparent}" Opacity="0.0"/>
    </Styles.Resources>

    
    <!-- Стили текста -->
    
    <Style Selector="TextBlock.ONE-Pararaph-Regular">
        <Setter Property="FontFamily" Value="DefaultFont" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>

    <Style Selector="TextBlock.ONE-Pararaph-Bold">
        <Setter Property="FontFamily" Value="DefaultFont" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    
    <Style Selector="TextBlock.ONE-H3-Bold">
        <Setter Property="FontFamily" Value="DefaultFont" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    
    <Style Selector="TextBlock.ONE-H3-Regular">
        <Setter Property="FontFamily" Value="DefaultFont" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>

    <Style Selector="TextBlock.ONE-H1-Medium">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    
    <Style Selector="TextBlock.ONE-H2-Medium">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    
    <Style Selector="TextBlock.ONE-H2-Bold">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    
    <Style Selector="TextBlock.One-Subs-Regular">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    
    <Style Selector="TextBlock.One-Subs-Bold">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
    </Style>
    
    <!-- Для активного режима - заменяем Image внутри кнопки -->
    <Style Selector="mxe|PopupEditor:activeMode /template/ mxev|EditorIconToggleButton#PART_PopupOpenButton Image">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    
</Styles>

