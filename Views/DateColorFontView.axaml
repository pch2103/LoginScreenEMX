<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:LoginScreenEMX.Helpers"
             xmlns:mxe="https://schemas.eremexcontrols.net/avalonia/editors"
             xmlns:loginScreenEmx="clr-namespace:LoginScreenEMX"
             Width="600"
             MinHeight="400"
             x:Class="LoginScreenEMX.Views.DateColorFontView"
             x:DataType="loginScreenEmx:DateColorFontViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <!-- 1. Заголовок-->
        <Border Grid.Row="0"
                Margin="{StaticResource ThemePaddingDown-Medium}"
                Height="{StaticResource ThemeSize-Double}">
            <Grid ColumnDefinitions="Auto, *,Auto">
                <!-- Область для перетаскивания -->
                <Border Grid.Column="0" Background="Transparent" Margin="0 0 6 0"
                        VerticalAlignment="Center"
                        PointerPressed="TitleBar_PointerPressed">
                    <Path Data="{StaticResource SettingIcon}"
                          Width="{StaticResource ThemeSize-Medium}"
                          Height="{StaticResource ThemeSize-Medium}"
                          Stretch="Uniform"
                          Stroke="Transparent"
                          Fill="{StaticResource ForegroundColor}" />
                </Border>
                <Border Grid.Column="1" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
                    <TextBlock Text="Date, Color, Font samples"
                               VerticalAlignment="Center"
                               Classes="ONE-H3-Bold" />
                </Border>
                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="Subtle IconOnlyMedium" Click="CloseButton_Click"
                            VerticalAlignment="Center">
                        <Path Data="{StaticResource CloseIcon}"
                              Width="{StaticResource ThemeSize-Regular}"
                              Height="{StaticResource ThemeSize-Regular}"
                              Stretch="Uniform"
                              Stroke="Transparent"
                              Fill="{StaticResource ForegroundColor}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="{StaticResource ThemePaddingDown-Medium}">
            <Grid>
                <!-- Фон для блока контента -->
                <Border Classes="content-background" />
                <!-- Функционал -->

                <Grid ColumnDefinitions="Auto *" Margin="{StaticResource ThemePadding-Medium}">
                    <!-- (/Resources/ModifiedResources.axaml) Кастомизация календаря - добавление возможности ввода времени -->

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- DateEditor -->
                        <StackPanel x:Name="DateBlock" Spacing="{StaticResource ThemeSize-Min}" IsVisible="True"
                                    Orientation="Vertical"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Date and Time Selector:"
                                       VerticalAlignment="Center"
                                       Classes="One-Subs-Regular" />
                            <mxe:DateEditor x:Name="MyDateEditor"
                                            MaskType="DateTime"
                                            Mask="dd.MM.yyyy  HH:mm:ss"
                                            DisplayFormatString="dd.MM.yyyy  HH:mm:ss"
                                            Width="180"
                                            Classes="Medium"
                                            DateTime="{Binding SelectedDateTime}"
                                            Tag="{Binding}">
                            </mxe:DateEditor>
                        </StackPanel>
                        <StackPanel x:Name="ColorBlock" Spacing="{StaticResource ThemeSize-Min}" IsVisible="True"
                                    Orientation="Vertical"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Color Picker:"
                                       VerticalAlignment="Center"
                                       Classes="One-Subs-Regular" />
                            <mxe:PopupColorEditor Classes="Medium Chevron" 
                                                  Name="popupColorEditor1" 
                                                  Width="180"
                                                  Color="{StaticResource ThemePrimaryColor}"
                                                  ColorsShowMode="StandardColors,CustomColors"
                                                  CustomColors="{Binding MyCustomColors}"/>
                        </StackPanel>
                        <StackPanel x:Name="FontBlock" Spacing="{StaticResource ThemeSize-Min}" IsVisible="True"
                                    Orientation="Vertical"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Font Style:"
                                       VerticalAlignment="Center"
                                       Classes="One-Subs-Regular" />
                            <mxe:PopupEditor x:Name="fontEditor"
                                             Classes="Medium FontIcon"
                                             CornerRadius="{StaticResource DefaultCornerRadius}"
                                             Theme="{StaticResource FontEditorTheme}"
                                             Width="180"
                                             Tag="{Binding SelectedFont}"
                                             EditorValue="{Binding SelectedFont.DisplayText}">
                            </mxe:PopupEditor>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>